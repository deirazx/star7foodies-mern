# ========================================================
# Star7 Foodies - Backend Environment Variables
# ========================================================

# Application Port (Render automatically supplies PORT in production)
PORT=8000

# Environment: "development" for local work, "production" on Render
NODE_ENV=development

# MongoDB Connection String (Atlas Cluster URI)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.ymktfz3.mongodb.net/star7foodies?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Cloudinary Storage Credentials for Menu Dish Images
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend URL for CORS (e.g. Netlify URL or Custom Domain)
# Required on Render so the backend allows requests from your Netlify domain
FRONTEND_URL=https://star7foodies.netlify.app
