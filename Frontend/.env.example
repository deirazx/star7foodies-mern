# ========================================================
# Star7 Foodies - Frontend Environment Variables
# ========================================================

# LOCAL DEVELOPMENT:
# Leave blank to let the Vite dev server proxy requests to http://localhost:8000
VITE_API_BASE_URL=

# PRODUCTION (NETLIFY):
# Set this variable in Netlify Dashboard -> Site settings -> Environment variables:
# VITE_API_BASE_URL=https://star7foodies-backend.onrender.com
